AGENTBANK_DATABASE_URL=sqlite:///agentbank.db
AGENTBANK_ENV=development
AGENTBANK_POLICY_VERSION=2026-10-28.1
# scripts/Start-Local.ps1 generates independent local credentials automatically.
# Compose requires independent random values for all six variables below.
PUBLIC_SESSION_SECRET=
PUBLIC_AUDIT_SECRET=
EVAL_SESSION_SECRET=
EVAL_AUDIT_SECRET=
EVAL_ADMIN_TOKEN=
EVAL_STAFF_TOKEN=

# Optional OpenAI-compatible LLM providers. Never commit real credentials.
AGENTBANK_LLM_PRIMARY_BASE_URL=
AGENTBANK_LLM_PRIMARY_API_KEY=
AGENTBANK_LLM_PRIMARY_MODEL=
AGENTBANK_LLM_PRIMARY_TIMEOUT_SECONDS=4
AGENTBANK_LLM_BACKUP_BASE_URL=
AGENTBANK_LLM_BACKUP_API_KEY=
AGENTBANK_LLM_BACKUP_MODEL=
AGENTBANK_LLM_BACKUP_TIMEOUT_SECONDS=4
# M3: optional independent audit HMAC key; locally generated key stays beside the database if unset.
AGENTBANK_AUDIT_SECRET=
# Maximum actual provider calls per UTC hour across all roles, retries and providers.
AGENTBANK_LLM_MAX_CALLS_PER_HOUR=1000
